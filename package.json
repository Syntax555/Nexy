{
  "name": "nexy-battle-lab",
  "version": "3.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "A typed, deterministic character matchup engine built for GitHub Pages.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "content:build": "tsx tools/content/build.ts",
    "content:check": "tsx tools/content/build.ts --check",
    "images:build": "tsx tools/images/build.ts",
    "images:strip-unpublished": "tsx tools/images/strip-unpublished.ts",
    "character:new": "tsx tools/content/new-character.ts",
    "predev": "pnpm content:build && pnpm images:build",
    "dev": "vite",
    "prebuild": "pnpm content:build && pnpm images:build",
    "build": "tsc --noEmit && vite build",
    "postbuild": "pnpm images:strip-unpublished",
    "preview": "vite preview",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write . && prettier --write \"*.md\" \"content/**/*.md\" \".github/**/*.{md,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"*.md\" \"content/**/*.md\" \".github/**/*.{md,yml,yaml}\"",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:config": "tsc --noEmit -p tsconfig.config.json",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:tools && pnpm typecheck:tests && pnpm typecheck:config",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "test:e2e:run": "playwright test",
    "pretest:e2e:headed": "pnpm build",
    "test:e2e:headed": "playwright test --headed",
    "check:fast": "pnpm content:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage",
    "check": "pnpm check:fast && pnpm build",
    "check:full": "pnpm check && pnpm test:e2e:run"
  },
  "dependencies": {
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "20.11.1",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
